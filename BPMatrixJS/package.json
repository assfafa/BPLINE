{
    "name": "bpmatrixjs",
    "version": "0.1.102",
    "type": "module",
    "main": "./lib/index.js",
    "module": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "files": [
        "lib",
        "releases"
    ],
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js"
        },
        "./Math": {
            "types": "./lib/Math/index.d.ts",
            "import": "./lib/Math/index.js"
        },
        "./Math/*": {
            "types": "./lib/Math/*.d.ts",
            "import": "./lib/Math/*.js"
        },
        "./Geometry": {
            "types": "./lib/Geometry/index.d.ts",
            "import": "./lib/Geometry/index.js"
        },
        "./Geometry/Poly": {
            "types": "./lib/Geometry/Poly/index.d.ts",
            "import": "./lib/Geometry/Poly/index.js"
        },
        "./Geometry/*": {
            "types": "./lib/Geometry/*.d.ts",
            "import": "./lib/Geometry/*.js"
        },
        "./Utils": {
            "types": "./lib/Utils/index.d.ts",
            "import": "./lib/Utils/index.js"
        }
    },
    "scripts": {
        "dev": "vite --host",
        "build": "npm run build:lib && npm run build:app",
        "build:app": "tsc && vite build",
        "build:lib": "tsc -p tsconfig.lib.json",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "pack:check": "npm pack --dry-run"
    },
    "devDependencies": {
        "@types/node": "^24.0.13",
        "@eslint/js": "^9.32.0",
        "@stylistic/eslint-plugin": "^5.2.3",
        "eslint": "^9.32.0",
        "globals": "^16.3.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.38.0",
        "vite": "^8.1.1"
    }
}
