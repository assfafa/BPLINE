{
    "name": "bpmatrixjs",
    "version": "0.1.104-beta.15",
    "type": "module",
    "main": "./lib/index.js",
    "module": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "files": [
        "lib",
        "agent.md",
        "releases"
    ],
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js"
        },
        "./Math": {
            "types": "./lib/Math/index.d.ts",
            "import": "./lib/Math/index.js"
        },
        "./Math/*": {
            "types": "./lib/Math/*.d.ts",
            "import": "./lib/Math/*.js"
        },
        "./Geometry": {
            "types": "./lib/Geometry/index.d.ts",
            "import": "./lib/Geometry/index.js"
        },
        "./Geometry/Poly": {
            "types": "./lib/Geometry/Poly/index.d.ts",
            "import": "./lib/Geometry/Poly/index.js"
        },
        "./Geometry/Text": {
            "types": "./lib/Geometry/Text/index.d.ts",
            "import": "./lib/Geometry/Text/index.js"
        },
        "./Geometry/*": {
            "types": "./lib/Geometry/*.d.ts",
            "import": "./lib/Geometry/*.js"
        },
        "./Utils": {
            "types": "./lib/Utils/index.d.ts",
            "import": "./lib/Utils/index.js"
        }
    },
    "scripts": {
        "predev": "npm run build:wasm",
        "dev": "vite --host",
        "build": "npm run build:lib && npm run build:app",
        "build:app": "npm run build:wasm && tsc && vite build",
        "build:wasm": "python3 src/scripts/Geometry/Wasm/src/build.py",
        "build:lib": "npm run build:wasm -- --clean-lib && npm run guides && tsc -p tsconfig.lib.json && node ../scripts/PackageGuides.mjs .",
        "precheck": "npm run build:wasm",
        "check": "tsc --noEmit && npm run lint && npm run guides:check",
        "guides": "node ../scripts/DirectoryGuides.mjs BPMatrixJS",
        "guides:check": "node ../scripts/DirectoryGuides.mjs BPMatrixJS --check",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepack": "npm run build:lib",
        "pack:check": "npm pack --dry-run"
    },
    "devDependencies": {
        "@eslint/js": "^9.32.0",
        "@stylistic/eslint-plugin": "^5.2.3",
        "@types/node": "^24.0.13",
        "eslint": "^9.32.0",
        "globals": "^16.3.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.38.0",
        "vite": "^8.1.1"
    }
}
